#!/bin/sh
# Git's repository environment must not reach tests that create repositories.
# shellcheck disable=SC2046 # one variable name per word
unset $(git rev-parse --local-env-vars)
if command -v daybreaker-otel >/dev/null 2>&1; then
  exec daybreaker-otel run --service local-gate --name pre-push -- scripts/check
fi
exec scripts/check

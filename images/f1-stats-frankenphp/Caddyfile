# Classic-mode FrankenPHP (no worker, no Octane) replacing nginx + php-fpm.
# Directive references: Caddyfile global options, https://caddyserver.com/docs/caddyfile/options ;
# FrankenPHP v1.13.5 php directive, https://frankenphp.dev/docs/config/ ;
# Caddy try_files https://caddyserver.com/docs/caddyfile/directives/try_files ;
# file_server https://caddyserver.com/docs/caddyfile/directives/file_server ;
# classic mode, https://frankenphp.dev/docs/classic/ .
# TLS terminates at Traefik, so nothing here listens on 80/443 or manages certs.
{
	# No admin socket, no stored config, no ACME: the root filesystem is
	# read-only and the only writable paths are the mounts the pod declares.
	admin off
	persist_config off
	auto_https off

	# Classic mode: every request boots PHP afresh on one of a fixed set of
	# threads. Five matches php-fpm's default pm.max_children, which the
	# Deployment's 768Mi limit was sized for. max_wait_time ends a request that
	# waited for a free thread as long as nginx's fastcgi_read_timeout.
	frankenphp {
		num_threads 5
		max_wait_time 60s
	}
}

# php_server would also run a directory's index.php and any existing .php file,
# so the pieces are spelled out: try_files serves an existing file and
# otherwise rewrites to /index.php (split_path keeps PATH_INFO of
# /index.php/...), php runs only /index.php, file_server serves static files.
(front) {
	try_files {path} /index.php {
		split_path .php
	}
	@front path /index.php /index.php/*
	php @front {
		env HTTPS {f1_https}
	}
	file_server
}

:8080 {
	root * /var/www/html/public

	# nginx's access_log went to stdout; Caddy's errors already go to stderr.
	log {
		output stdout
	}

	# Matches nginx client_max_body_size 16M.
	request_body {
		max_size 16MiB
	}

	# Laravel builds absolute URLs from HTTPS. The request reaches Caddy over
	# plain HTTP, so the scheme comes from Traefik's header; the application's
	# TrustProxies trusts no proxy, hence $_SERVER['HTTPS'] is set here.
	map {header.X-Forwarded-Proto} {f1_https} {
		https on
		default ""
	}

	# Same headers nginx added to every response except /healthz.
	@app not path /healthz
	header @app {
		+X-Frame-Options "SAMEORIGIN"
		+X-Content-Type-Options "nosniff"
		+Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Liveness page: a PHP thread answers, Laravel and MySQL are not touched.
	# The headers name what this image was built from, so a release can tell
	# when it is the one serving. log_skip keeps probes out of the access log,
	# as nginx's access_log off did.
	handle /healthz {
		log_skip
		header X-F1-Revision "__UPSTREAM_SHA__"
		header X-F1-Packaging "__PACKAGING_SHA__"
		root * /opt/f1-stats/health
		rewrite * /healthz.php
		php
	}

	# nginx denies "/." unless followed by "well-known/". RE2 has no lookahead,
	# so the pattern lists every way the text after "/." can differ from it.
	@denied {
		path_regexp dotfile /\.(?:[^w]|$|w(?:[^e]|$|e(?:[^l]|$|l(?:[^l]|$|l(?:[^-]|$|-(?:[^k]|$|k(?:[^n]|$|n(?:[^o]|$|o(?:[^w]|$|w(?:[^n]|$|n(?:[^/]|$)))))))))))
	}
	@composer path_regexp (?i)(^|/)composer\.(json|lock)$
	@internal path_regexp (?i)^/(storage|vendor)/
	handle @denied {
		respond 403
	}
	handle @composer {
		respond 403
	}
	handle @internal {
		respond 403
	}

	# Only the front controller executes, as in nginx. Any path with a ".php"
	# segment that does not start at /index.php (/x.php, /x.php/extra,
	# /dir/x.php/more) falls through to Laravel as nginx's error_page 404
	# /index.php did.
	@strayphp {
		path_regexp \.php(/|$)
		not path_regexp ^/index\.php(/|$)
	}
	handle @strayphp {
		rewrite * /index.php
		import front
	}

	# nginx's "try_files $uri $uri/" answers an existing directory itself: a
	# redirect to the slash form, or 403 where it holds no index.php (autoindex
	# is off). A directory that does hold one falls through to Laravel's 404.
	# A "/" suffix in try_files and the file matcher only matches directories:
	# https://caddyserver.com/docs/caddyfile/matchers#file
	@dirslash {
		path */
		file {
			try_files {path}
		}
		not file {
			try_files {path}index.php
		}
	}
	@dirnoslash {
		not path */
		expression {http.request.uri.query} == ''
		file {
			try_files {path}/
		}
	}
	@dirnoslashq {
		not path */
		expression {http.request.uri.query} != ''
		file {
			try_files {path}/
		}
	}
	handle @dirslash {
		respond 403
	}
	handle @dirnoslash {
		redir {path}/ 301
	}
	handle @dirnoslashq {
		redir {path}/?{query} 301
	}

	handle {
		import front
	}
}
